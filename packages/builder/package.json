{
  "name": "@afilmory/builder",
  "type": "module",
  "version": "0.1.3",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*",
    "./photo-types": "./src/photo-types.ts"
  },
  "scripts": {
    "build": "tsdown",
    "bump": "nbump",
    "cli": "tsx src/cli.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@afilmory/utils": "workspace:*",
    "@aws-sdk/client-s3": "3.1041.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@smithy/node-http-handler": "4.6.1",
    "@vingle/bmp-js": "^0.2.5",
    "blurhash": "2.0.5",
    "c12": "^3.3.1",
    "consola": "3.4.2",
    "dotenv-expand": "catalog:",
    "es-toolkit": "1.46.1",
    "execa": "9.6.0",
    "exiftool-vendored": "35.19.0",
    "heic-convert": "2.1.0",
    "sharp": "0.35.0",
    "thumbhash": "0.1.1"
  },
  "devDependencies": {
    "nbump": "2.1.8",
    "tsdown": "0.15.12"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "import": "./dist/*.js"
      },
      "./photo-types": {
        "types": "./dist/photo-types.d.ts",
        "import": "./dist/photo-types.js"
      }
    }
  }
}
