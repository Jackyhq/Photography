{
  "name": "@afilmory/monorepo",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jackyhq/Photography"
  },
  "scripts": {
    "build": "pnpm --filter web build",
    "build:manifest": "pnpm --filter @afilmory/builder cli",
    "bundle:budget": "tsx scripts/check-bundle-budget.ts",
    "create:doc": "tsx scripts/create-doc.ts",
    "dev": "pnpm --filter web dev",
    "docs:build": "pnpm --filter @afilmory/docs build",
    "docs:dev": "pnpm --filter @afilmory/docs dev",
    "docs:preview": "pnpm --filter @afilmory/docs preview",
    "fixtures:photos": "tsx scripts/create-e2e-photo-fixture.ts",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,jsx,json,css,md,mdx}\" \"packages/**/*.{ts,tsx,js,jsx,json,css,md,mdx}\" \"scripts/**/*.{ts,tsx,js,jsx,json,css,md,mdx}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,jsx,json,css,md,mdx}\" \"packages/**/*.{ts,tsx,js,jsx,json,css,md,mdx}\" \"scripts/**/*.{ts,tsx,js,jsx,json,css,md,mdx}\"",
    "lint": "eslint --fix",
    "lint:check": "eslint .",
    "photos:descriptions:sync": "tsx scripts/sync-photo-descriptions.ts",
    "photos:standardize": "tsx scripts/standardize-photos.ts",
    "preinstall": "sh scripts/preinstall.sh",
    "prepare": "simple-git-hooks",
    "seo:check": "pnpm --filter web seo:check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "type-check": "pnpm -r --if-present type-check",
    "update:lastmodified": "tsx scripts/update-lastmodified.ts",
    "vercel:build": "pnpm run vercel:photos && pnpm run photos:standardize && pnpm run build",
    "vercel:photos": "sh scripts/checkout-vercel-photos.sh"
  },
  "dependencies": {
    "@afilmory/builder": "workspace:*",
    "@t3-oss/env-core": "catalog:",
    "dotenv": "17.4.2",
    "es-toolkit": "1.46.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@clack/prompts": "^0.11.0",
    "@innei/prettier": "1.0.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "24.9.2",
    "@vitest/coverage-v8": "^4.1.7",
    "ast-kit": "2.2.0",
    "baseline-browser-mapping": "^2.10.0",
    "consola": "3.4.2",
    "dotenv-expand": "catalog:",
    "eslint": "9.39.4",
    "eslint-config-hyoban": "4.0.10",
    "exiftool-vendored": "35.19.0",
    "fast-glob": "3.3.3",
    "jsdom": "^29.1.1",
    "lint-staged": "16.4.0",
    "nbump": "2.1.8",
    "prettier": "3.8.3",
    "sharp": "0.35.0",
    "simple-git-hooks": "2.13.1",
    "tailwindcss": "catalog:",
    "tsx": "4.21.0",
    "typescript": "catalog:",
    "unplugin-ast": "0.16.0",
    "vite": "7.3.5",
    "vite-bundle-analyzer": "1.3.8",
    "vite-plugin-checker": "0.13.0",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "^4.1.7"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.7",
      "@conventional-changelog/git-client": "2.0.0",
      "ajv@8.12.0": "8.18.0",
      "ajv@8.13.0": "8.18.0",
      "esbuild": "0.28.1",
      "defu@6.1.4": "6.1.7",
      "diff@8.0.2": "8.0.4",
      "@babel/plugin-transform-modules-systemjs": "7.29.4",
      "brace-expansion@1.1.14": "2.1.4",
      "brace-expansion@2.1.0": "2.1.4",
      "brace-expansion@5.0.5": "5.0.9",
      "fast-uri": "3.1.6",
      "fast-xml-builder": "1.1.7",
      "flatted@3.3.3": "3.4.2",
      "handlebars@4.7.8": "4.7.9",
      "js-yaml": "4.3.1",
      "lodash@4.17.23": "4.18.1",
      "mdast-util-to-hast@13.2.0": "13.2.1",
      "minimatch@3.1.2": "3.1.5",
      "minimatch@10.0.3": "10.2.5",
      "preact@10.27.2": "10.29.1",
      "protocol-buffers-schema@3.6.0": "3.6.1",
      "serialize-javascript@6.0.2": "7.0.5",
      "serialize-javascript@7.0.2": "7.0.5",
      "@typescript-eslint/parser@8.46.1": "8.46.2",
      "undici": "7.29.0",
      "yaml@1.10.2": "1.10.3",
      "yaml@2.8.1": "2.8.4"
    }
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cjs,mjs,json}": [
      "prettier --ignore-path .gitignore --ignore-path .prettierignore --write",
      "eslint --fix"
    ],
    "*.{css,yml,yaml}": [
      "prettier --ignore-path .gitignore --ignore-path .prettierignore --write"
    ],
    "*.{md,mdx}": [
      "pnpm update:lastmodified",
      "prettier --ignore-path .gitignore --ignore-path .prettierignore --write"
    ]
  }
}
